{
  "name": "grindstone",
  "displayName": "Grindstone",
  "description": "Persistent DSA workstation layout manager for VS Code",
  "version": "2.0.0",
  "publisher": "sujalnath",
  "engines": {
    "vscode": "^1.74.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:grindstone.openProblem",
    "onCommand:grindstone.openProblemPath",
    "onCommand:grindstone.clearLayout",
    "onCommand:grindstone.newProblem",
    "onCommand:grindstone.deleteProblem",
    "onCommand:grindstone.runSolution",
    "onCommand:grindstone.showIndexStats"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "grindstone.openProblem",
        "title": "DSA: Open Problem Layout"
      },
      {
        "command": "grindstone.openProblemPath",
        "title": "DSA: Open Problem Path"
      },
      {
        "command": "grindstone.clearLayout",
        "title": "DSA: Clear Layout"
      },
      {
        "command": "grindstone.newProblem",
        "title": "DSA: New Problem"
      },
      {
        "command": "grindstone.deleteProblem",
        "title": "DSA: Delete Problem"
      },
      {
        "command": "grindstone.runSolution",
        "title": "DSA: Run Solution"
      },
      {
        "command": "grindstone.showIndexStats",
        "title": "DSA: Show Index Stats"
      }
    ],
    "keybindings": [
      {
        "command": "grindstone.openProblem",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      },
      {
        "command": "grindstone.clearLayout",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c"
      },
      {
        "command": "grindstone.newProblem",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n"
      },
      {
        "command": "grindstone.deleteProblem",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d"
      },
      {
        "command": "grindstone.runSolution",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "explorerResourceIsFolder",
          "command": "grindstone.openProblemPath",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "GrindStone",
      "properties": {
        "grindstone.openProblemAsPreview": {
          "type": "boolean",
          "default": false,
          "description": "Open PROBLEM.md as a rendered Markdown Preview instead of a text editor."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.8.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "node-html-parser": "^7.1.0"
  }
}
